{
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			]
		},
		"layout": {
			"contentSize": "var(--theme-block-max-width)",
			"wideSize": "var(--theme-block-wide-max-width)",
			"fullSize": "none"
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{
					"fluid": false,
					"size": "13px",
					"slug": "small"
				},
				{
					"fluid": false,
					"size": "20px",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "22px",
						"max": "30px"
					},
					"size": "30px",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "30px",
						"max": "50px"
					},
					"size": "50px",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "45px",
						"max": "80px"
					},
					"size": "80px",
					"slug": "xx-large"
				}
			],
			"fontFamilies": [
				{
					"fontFamily": "amerika",
					"slug": "amerika",
					"fontFace": [
						{
							"fontFamily": "amerika",
							"fontStretch": "",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": "http://localhost/soyanshop/wp-content/uploads/useanyfont/7394amerika.woff2"
						}
					],
					"isUAF": true
				}
			]
		}
	},
	"styles": {
		"elements": {
			"link": {
				"typography": {
					"textDecoration": false
				}
			},
			"button": {
				"spacing": {
					"padding": false
				},
				"border": {
					"width": false
				},
				"color": {
					"background": false,
					"text": false
				},
				"typography": {
					"fontFamily": false,
					"fontSize": false,
					"lineHeight": false,
					"textDecoration": false
				}
			}
		},
		"spacing": {
			"blockGap": "var(--theme-content-spacing)"
		}
	}
}